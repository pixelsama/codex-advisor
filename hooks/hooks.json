{
  "description": "Inject Codex Advisor instructions and guard classic V1 Advisor calls.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/advisor_context.py\"",
            "commandWindows": "py -3 -X utf8 \"${PLUGIN_ROOT}/hooks/advisor_context.py\"",
            "timeout": 5,
            "statusMessage": "Loading Codex Advisor settings",
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Agent$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/advisor_guard.py\"",
            "commandWindows": "py -3 -X utf8 \"${PLUGIN_ROOT}/hooks/advisor_guard.py\"",
            "timeout": 5,
            "statusMessage": "Checking classic Codex Advisor call"
          }
        ]
      }
    ]
  }
}

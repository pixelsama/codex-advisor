{
  "description": "Inject and guard manually configured Codex Advisor subagent calls.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/advisor_context.py\"",
            "timeout": 5,
            "statusMessage": "Loading Codex Advisor settings",
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/advisor_guard.py\"",
            "timeout": 5,
            "statusMessage": "Checking Codex Advisor subagent call"
          }
        ]
      }
    ]
  }
}
